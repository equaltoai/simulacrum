{
	"name": "simulacrum",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"overrides": {
			"cookie": "0.7.2",
			"fast-xml-parser": "5.8.0",
			"fast-uri": "3.1.4",
			"fast-xml-builder": "1.2.0",
			"esbuild": "0.28.1",
			"vite": "8.0.16",
			"ws": "8.21.0"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --ssr src/facetheory/entry-server.ts && node scripts/copy-facetheory-manifest.mjs",
		"preview": "vite preview",
		"prepare": "node -e \"\"",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"api:contracts": "node scripts/update-contracts.mjs",
		"api:test": "node scripts/api-test.mjs",
		"browser:test": "playwright test",
		"browser:test:headed": "playwright test --headed",
		"browser:test:live": "node scripts/browser-test-live.mjs",
		"browser:test:ui": "playwright test --ui",
		"test": "node --test tests/api/_harness/*.test.mjs",
		"deploy": "node scripts/deploy-client.mjs",
		"deploy:dev": "node scripts/deploy-client.mjs --target all --stage dev",
		"deploy:simulacrum:dev": "node scripts/deploy-client.mjs --target simulacrum --stage dev",
		"deploy:theory:dev": "node scripts/deploy-client.mjs --target theory --stage dev",
		"deploy:theory:live": "node scripts/deploy-client.mjs --target theory --stage live",
		"deploy:trench:dev": "node scripts/deploy-client.mjs --target trench --stage dev"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24.12.0",
		"ajv": "^8.18.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.6",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"@apollo/client": "^4.1.6",
		"@apollo/client-react-streaming": "^0.14.4",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@noble/hashes": "^2.0.1",
		"@tanstack/svelte-virtual": "^3.13.23",
		"@theory-cloud/apptheory": "https://github.com/theory-cloud/AppTheory/releases/download/v4.0.0/theory-cloud-apptheory-4.0.0.tgz#sha512-dnkEPAlNov7fOM5k5dxX7KYT2DeIUVEtE8l3MH9LvHw=",
		"@theory-cloud/facetheory": "https://github.com/theory-cloud/FaceTheory/releases/download/v4.0.1/theory-cloud-facetheory-4.0.1.tgz",
		"@theory-cloud/tabletheory-ts": "https://github.com/theory-cloud/TableTheory/releases/download/v2.0.3/theory-cloud-tabletheory-ts-2.0.3.tgz",
		"acorn": "^8.16.0",
		"focus-trap": "^8.0.0",
		"graphql": "^16.13.1",
		"graphql-ws": "^6.0.7",
		"hast-util-sanitize": "^5.0.2",
		"hast-util-to-mdast": "^10.1.2",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"rehype-parse": "^9.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.0.2",
		"tabbable": "^6.4.0",
		"unified": "^11.0.5",
		"viem": "^2.47.5"
	}
}
